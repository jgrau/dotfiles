{
  "title": "Control when held, Escape when tapped",
  "rules": [
    {
      "description": "Caps Lock and left Control: hold for Control, tap for Escape (250 ms)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "caps_lock",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "left_control" }],
          "to_if_alone": [{ "key_code": "escape" }],
          "parameters": { "basic.to_if_alone_timeout_milliseconds": 250 }
        },
        {
          "type": "basic",
          "from": {
            "key_code": "left_control",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "left_control" }],
          "to_if_alone": [{ "key_code": "escape" }],
          "parameters": { "basic.to_if_alone_timeout_milliseconds": 250 }
        }
      ]
    }
  ]
}
