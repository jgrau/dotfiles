// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "edit_predictions": {
    "mode": "eager",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null
    },
    "enabled_in_text_threads": false
  },
  "context_servers": {
    "landfolk": {
      "command": {
        "path": "npx",
        "args": [
          "mcp-remote",
          "http://localhost:3000/mcp/sse",
          "--allow-http",
          "--skip-browser-auth"
        ],
        "env": null
      },
      "settings": {}
    },
    "postgres-context-server": {
      "settings": {
        "database_url": "postgresql://jgrau@localhost:5432/landfolk_development"
      }
    }
  },
  "agent": {
    "always_allow_tool_actions": true,
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-latest"
    },
    "default_profile": "write",
    "model_parameters": [],
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-latest"
    },
    "version": "2"
  },
  "features": {
    "edit_prediction_provider": "zed"
  },
  "vim_mode": true,
  "ui_font_size": 15,
  "buffer_font_family": "MesloLGL Nerd Font",
  "buffer_font_size": 13,
  "theme": {
    "mode": "system",
    "light": "One Dark",
    "dark": "One Dark"
  },
  "languages": {
    "Ruby": {
      "language_servers": [
        "ruby-lsp",
        "sorbet",
        "rubocop",
        "!solargraph",
        "..."
      ]
    }
  },
  "lsp": {
    "ruby-lsp": {
      "initializationOptions": {
        "enabledFeatures": {
          "codeActions": true,
          "codeLens": true,
          "completion": true,
          "definition": true,
          "diagnostics": true,
          "documentHighlights": true,
          "documentLink": true,
          "documentSymbols": true,
          "foldingRanges": true,
          "formatting": true,
          "hover": true,
          "inlayHint": true,
          "onTypeFormatting": false,
          "selectionRanges": true,
          "semanticHighlighting": true,
          "signatureHelp": true,
          "typeHierarchy": true,
          "workspaceSymbol": true
        },
        "featuresConfiguration": {
          "inlayHint": {
            "implicitHashValue": true,
            "implicitRescue": true
          }
        },
        "indexing": {
          "excludedPatterns": ["path/to/excluded/file.rb"],
          "includedPatterns": ["path/to/included/file.rb"],
          "excludedGems": ["gem1", "gem2", "etc."],
          "excludedMagicComments": ["compiled:true"]
        },
        "formatter": "syntax_tree",
        "linters": [],
        "experimentalFeaturesEnabled": false
      }
    }
  }
}
